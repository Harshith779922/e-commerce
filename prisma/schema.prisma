generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String
  name          String
  phone         String?
  role          String           @default("CUSTOMER") // "CUSTOMER" or "ADMIN"
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  profile       CustomerProfile?
  addresses     Address[]
  orders        Order[]
  wishlists     Wishlist[]
  reviews       Review[]
  auditLogs     AuditLog[]
}

model CustomerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loyaltyTier   String   @default("SILVER") // "SILVER", "GOLD", "PLATINUM", "BESPOKE_VIP"
  spentTotal    Float    @default(0.0)
  preferences   String?  // JSON string
  updatedAt     DateTime @updatedAt
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  street       String
  city         String
  state        String
  pinCode      String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
  type         String   @default("HOME") // "HOME" or "WORK"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?
  bannerImage  String?
  displayOrder Int       @default(0)
  products     Product[]
}

model Collection {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  subtitle     String?
  description  String?
  image        String?
  featured     Boolean   @default(false)
  products     Product[]
}

model Product {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  sku               String           @unique
  shortDescription  String?
  description       String
  price             Float
  salePrice         Float?
  gender            String           @default("UNISEX") // "MEN", "WOMEN", "UNISEX"
  isFeatured        Boolean          @default(false)
  isNewArrival      Boolean          @default(false)
  isActive          Boolean          @default(true)
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])
  collectionId      String?
  collection        Collection?      @relation(fields: [collectionId], references: [id])
  fabricDetails     String?
  careInstructions  String?
  specifications    String?          // JSON string
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  images            ProductImage[]
  variants          ProductVariant[]
  orderItems        OrderItem[]
  wishlists         Wishlist[]
  reviews           Review[]
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String   // e.g. "S", "M", "L", "XL", "48", "50", "42"
  colorName     String   // e.g. "Obsidian Black", "Imperial Gold"
  colorHex      String   // e.g. "#000000", "#C5A46D"
  sku           String   @unique
  stockQuantity Int      @default(10)
  priceDelta    Float    @default(0.0)
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id])
  customerEmail      String
  customerName       String
  customerPhone      String
  shippingAddress    String      // JSON string of address
  shippingMethod     String      @default("STANDARD") // "STANDARD", "EXPRESS"
  subtotal           Float
  discount           Float       @default(0.0)
  shippingFee        Float       @default(0.0)
  total              Float
  status             String      @default("CONFIRMED") // "PENDING", "CONFIRMED", "PROCESSING", "SHIPPED", "OUT_FOR_DELIVERY", "DELIVERED", "CANCELLED", "REFUNDED"
  paymentStatus      String      @default("PAID")      // "PENDING", "PAID", "FAILED", "REFUNDED"
  paymentMethod      String      @default("RAZORPAY")
  razorpayOrderId    String?
  razorpayPaymentId  String?
  trackingNumber     String?
  carrier            String?     @default("Bespoke White-Glove Express")
  estimatedDelivery  DateTime?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]
  payments           Payment[]
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  productName  String
  productPrice Float
  size         String
  color        String
  quantity     Int
  subtotal     Float
  imageUrl     String?
}

model Payment {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount           Float
  status           String   @default("PAID")
  gateway          String   @default("RAZORPAY")
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  createdAt        DateTime @default(now())
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String    @default("PERCENTAGE") // "PERCENTAGE" or "FIXED"
  discountValue  Float
  minOrderValue  Float     @default(0.0)
  maxDiscount    Float?
  isActive       Boolean   @default(true)
  usedCount      Int       @default(0)
  validUntil     DateTime?
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int      @default(5)
  title              String?
  comment            String
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)
}

model Banner {
  id           String  @id @default(cuid())
  title        String
  subtitle     String?
  tag          String?
  image        String
  linkUrl      String  @default("/collections")
  ctaText      String  @default("EXPLORE COLLECTION")
  placement    String  @default("HERO") // "HERO", "FEATURED_COLLECTION", "EDITORIAL"
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

